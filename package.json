{
  "name": "desk-ocr",
  "version": "0.1.0",
  "description": "Privacy-first desktop screenshot OCR with searchable text overlays.",
  "private": true,
  "license": "MIT",
  "keywords": [
    "ocr",
    "electron",
    "paddleocr",
    "screenshot",
    "desktop"
  ],
  "engines": {
    "node": ">=22.12",
    "npm": ">=10"
  },
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "postinstall": "node scripts/install-electron.mjs",
    "dev": "concurrently -k -n OCR,APP -c cyan,green \"npm:dev:ocr\" \"npm:dev:electron\"",
    "dev:electron": "electron-vite dev",
    "dev:ocr": "node scripts/dev-ocr.mjs",
    "build": "electron-vite build",
    "preview": "concurrently -k -n OCR,APP -c cyan,green \"npm:dev:ocr\" \"npm:preview:electron\"",
    "preview:electron": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ocr": "node scripts/run-python.mjs -m pytest services/ocr/tests",
    "lint:python": "node scripts/run-python.mjs -m ruff check services",
    "format:python": "node scripts/run-python.mjs -m ruff format services",
    "format:python:check": "node scripts/run-python.mjs -m ruff format --check services",
    "check:frontend": "npm run typecheck && npm test && npm run build",
    "check": "npm run check:frontend && npm run test:ocr && npm run lint:python && npm run format:python:check",
    "install:python": "node scripts/install-python.mjs",
    "install:python:dev": "node scripts/install-python.mjs --dev"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.5",
    "electron": "^43.4.1",
    "electron-vite": "^3.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
