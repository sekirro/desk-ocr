# Optional Desk OCR overrides. Copy this file to .env or export the variables
# in the shell before running npm run dev.

# Use an existing system, Conda, or other Python environment instead of .venv.
# That environment must already contain services/ocr/requirements.txt.
# DESK_OCR_PYTHON=python

DESK_OCR_TEXT_DETECTION_MODEL=PP-OCRv5_mobile_det
DESK_OCR_TEXT_RECOGNITION_MODEL=PP-OCRv5_mobile_rec
DESK_OCR_MAX_IMAGE_BYTES=20971520
DESK_OCR_MAX_IMAGE_PIXELS=40000000
PADDLE_PDX_MODEL_SOURCE=bos
PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=True
